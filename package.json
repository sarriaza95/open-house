{
  "name": "openhouse-scheduler",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
